<%- include('../partials/head') %>
  <body class="bg-slate-100 min-h-screen">
    <%- include('../partials/nav') %>

    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <!-- Page Header -->
      <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
            My Bookings
          </h1>
          <p class="mt-1 text-sm text-slate-500">
            View and manage your upcoming stays, reservations, and trip details.
          </p>
        </div>
        <a
          href="/homes"
          class="inline-flex items-center gap-1.5 rounded-full bg-slate-900 px-5 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-slate-800 hover:-translate-y-0.5"
        >
          Explore more stays <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Success Alert Banner -->
      <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50/90 p-5 text-emerald-900 shadow-sm">
          <div class="flex items-start gap-3">
            <span class="text-2xl" aria-hidden="true">🎉</span>
            <div>
              <h3 class="font-bold text-base text-emerald-950">Reservation Confirmed!</h3>
              <p class="mt-0.5 text-sm text-emerald-800"><%= successMessage %></p>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Bookings List -->
      <% if (bookings && bookings.length > 0) { %>
        <div class="space-y-6">
          <% bookings.forEach(booking => { %>
            <% if (booking.home) { %>
              <div class="overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-md transition duration-200 hover:shadow-lg">
                <div class="grid grid-cols-1 md:grid-cols-12">
                  <!-- Photo Column -->
                  <div class="relative md:col-span-4 lg:col-span-3">
                    <a href="/homes/<%= booking.home._id %>" class="block h-52 w-full md:h-full">
                      <img
                        src="<%= booking.home.photo %>"
                        alt="<%= booking.home.houseName %>"
                        class="h-full w-full object-cover"
                      />
                    </a>
                    <span class="absolute top-3 left-3 rounded-md bg-black/60 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur-sm">
                      <span aria-hidden="true">★</span> <%= booking.home.rating %>
                    </span>
                  </div>

                  <!-- Details Column -->
                  <div class="flex flex-col justify-between p-6 md:col-span-8 lg:col-span-9">
                    <div>
                      <!-- Header row: Ref & Status Badge -->
                      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
                        <span class="text-xs font-mono font-semibold tracking-wider text-slate-400 uppercase">
                          Booking ID: #<%= booking._id.toString().slice(-8).toUpperCase() %>
                        </span>

                        <% if (booking.status === 'confirmed') { %>
                          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800">
                            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span> Confirmed
                          </span>
                        <% } else if (booking.status === 'cancelled') { %>
                          <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">
                            <span class="h-2 w-2 rounded-full bg-slate-400"></span> Cancelled
                          </span>
                        <% } else { %>
                          <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-800">
                            <span class="h-2 w-2 rounded-full bg-blue-500"></span> Completed
                          </span>
                        <% } %>
                      </div>

                      <!-- Stay Title & Location -->
                      <div class="mt-3">
                        <h2 class="text-xl font-bold text-slate-900 hover:text-rose-600 transition">
                          <a href="/homes/<%= booking.home._id %>"><%= booking.home.houseName %></a>
                        </h2>
                        <p class="mt-0.5 text-xs text-slate-500">
                          <span aria-hidden="true">⌖</span> <%= booking.home.location %>
                        </p>
                      </div>

                      <!-- Dates & Trip Info Grid -->
                      <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4 rounded-xl bg-slate-50 p-4 border border-slate-100 text-xs">
                        <div>
                          <span class="text-slate-400 block font-semibold uppercase">Check-in</span>
                          <span class="font-bold text-slate-800 text-sm">
                            <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                          </span>
                        </div>
                        <div>
                          <span class="text-slate-400 block font-semibold uppercase">Check-out</span>
                          <span class="font-bold text-slate-800 text-sm">
                            <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                          </span>
                        </div>
                        <div>
                          <span class="text-slate-400 block font-semibold uppercase">Duration</span>
                          <span class="font-bold text-slate-800 text-sm">
                            <%= booking.nights %> night<%= booking.nights > 1 ? 's' : '' %>
                          </span>
                        </div>
                        <div>
                          <span class="text-slate-400 block font-semibold uppercase">Guests</span>
                          <span class="font-bold text-slate-800 text-sm">
                            <%= booking.guests %> guest<%= booking.guests > 1 ? 's' : '' %>
                          </span>
                        </div>
                      </div>

                      <% if (booking.specialRequests) { %>
                        <p class="mt-3 text-xs text-slate-500 italic bg-amber-50/70 border border-amber-100 p-2.5 rounded-lg">
                          <strong>Note for host:</strong> "<%= booking.specialRequests %>"
                        </p>
                      <% } %>
                    </div>

                    <!-- Footer: Total Price & Action Buttons -->
                    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 pt-4">
                      <div>
                        <span class="text-xs text-slate-400 block">Total Paid</span>
                        <span class="text-xl font-black text-rose-600">
                          ₹<%= booking.totalPrice ? booking.totalPrice.toLocaleString('en-IN') : (booking.nights * booking.pricePerNight).toLocaleString('en-IN') %>
                        </span>
                        <span class="text-xs text-slate-400 font-medium"> (₹<%= booking.pricePerNight %>/night)</span>
                      </div>

                      <div class="flex items-center gap-3">
                        <a
                          href="/homes/<%= booking.home._id %>"
                          class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 hover:border-slate-300"
                        >
                          View Stay
                        </a>

                        <% if (booking.status === 'confirmed') { %>
                          <form
                            action="/bookings/<%= booking._id %>/cancel"
                            method="POST"
                            onsubmit="return confirm('Are you sure you want to cancel your reservation for <%= booking.home.houseName %>?');"
                          >
                            <button
                              type="submit"
                              class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-2 text-xs font-bold text-rose-700 transition hover:bg-rose-100 hover:border-rose-300"
                            >
                              Cancel Booking
                            </button>
                          </form>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>
          <% }); %>
        </div>
      <% } else { %>
        <!-- Empty State -->
        <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-12 text-center shadow-sm">
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-rose-50 text-3xl text-rose-600 mb-4">
            ⌂
          </div>
          <h2 class="text-2xl font-bold text-slate-900">No reservations yet</h2>
          <p class="mx-auto mt-2 max-w-md text-sm text-slate-500 leading-relaxed">
            You haven't booked any trips on homyfyy yet. Find a cozy place that suits your travel plans and make your first reservation.
          </p>
          <div class="mt-6">
            <a
              href="/homes"
              class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-rose-600 to-red-600 px-6 py-3 text-sm font-bold text-white shadow-md shadow-rose-500/25 transition duration-200 hover:-translate-y-0.5 hover:from-rose-700 hover:to-red-700 hover:shadow-lg"
            >
              Browse Available Homes <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      <% } %>
    </main>
  </body>
</html>