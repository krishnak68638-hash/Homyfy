<%- include('../partials/head') %>
  <body class="bg-slate-100 min-h-screen">
    <%- include('../partials/nav') %>

    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="mb-6">
        <a
          href="/homes/<%= home._id %>"
          class="inline-flex items-center text-sm font-semibold text-rose-600 transition hover:text-rose-700 hover:underline"
        >
          <span aria-hidden="true" class="mr-1.5 text-lg">←</span> Back to <%= home.houseName %>
        </a>
      </div>

      <div class="mb-8">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
          Request to book
        </h1>
        <p class="mt-1 text-sm text-slate-500">
          Review details and confirm your reservation with host.
        </p>
      </div>

      <% if (errorMessage) { %>
        <div class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-medium text-rose-800 shadow-sm">
          <div class="flex items-center gap-2">
            <span class="text-rose-600 font-bold" aria-hidden="true">⚠️</span>
            <span><%= errorMessage %></span>
          </div>
        </div>
      <% } %>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <!-- Booking Form Column -->
        <div class="lg:col-span-7">
          <form
            action="/homes/<%= home._id %>/reserve"
            method="POST"
            class="space-y-6 rounded-2xl border border-slate-200/80 bg-white p-6 shadow-md sm:p-8"
          >
            <!-- Dates Section -->
            <div>
              <h2 class="text-lg font-bold text-slate-900">1. Select your stay dates</h2>
              <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                  <label for="checkIn" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                    Check-in
                  </label>
                  <input
                    type="date"
                    id="checkIn"
                    name="checkIn"
                    required
                    value="<%= oldInput && oldInput.checkIn ? oldInput.checkIn : '' %>"
                    class="mt-1.5 block w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm font-medium text-slate-800 transition focus:border-rose-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-200"
                  />
                </div>
                <div>
                  <label for="checkOut" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                    Check-out
                  </label>
                  <input
                    type="date"
                    id="checkOut"
                    name="checkOut"
                    required
                    value="<%= oldInput && oldInput.checkOut ? oldInput.checkOut : '' %>"
                    class="mt-1.5 block w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm font-medium text-slate-800 transition focus:border-rose-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-200"
                  />
                </div>
              </div>
            </div>

            <!-- Guests Section -->
            <div class="border-t border-slate-100 pt-6">
              <h2 class="text-lg font-bold text-slate-900">2. Number of guests</h2>
              <div class="mt-4">
                <label for="guests" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                  Guests
                </label>
                <select
                  id="guests"
                  name="guests"
                  class="mt-1.5 block w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm font-medium text-slate-800 transition focus:border-rose-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-200"
                >
                  <option value="1" <%= (oldInput && oldInput.guests == 1) ? 'selected' : '' %>>1 Guest</option>
                  <option value="2" <%= (!oldInput || !oldInput.guests || oldInput.guests == 2) ? 'selected' : '' %>>2 Guests</option>
                  <option value="3" <%= (oldInput && oldInput.guests == 3) ? 'selected' : '' %>>3 Guests</option>
                  <option value="4" <%= (oldInput && oldInput.guests == 4) ? 'selected' : '' %>>4 Guests</option>
                  <option value="5" <%= (oldInput && oldInput.guests == 5) ? 'selected' : '' %>>5 Guests</option>
                  <option value="6" <%= (oldInput && oldInput.guests == 6) ? 'selected' : '' %>>6+ Guests</option>
                </select>
              </div>
            </div>

            <!-- Guest Contact Info -->
            <div class="border-t border-slate-100 pt-6">
              <h2 class="text-lg font-bold text-slate-900">3. Guest information</h2>
              <div class="mt-4 space-y-4">
                <div>
                  <label for="guestName" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                    Primary Guest Name
                  </label>
                  <input
                    type="text"
                    id="guestName"
                    name="guestName"
                    required
                    value="<%= oldInput && oldInput.guestName ? oldInput.guestName : (user ? (user.firstName + ' ' + (user.lastName || '')).trim() : '') %>"
                    placeholder="e.g. John Doe"
                    class="mt-1.5 block w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm text-slate-800 transition focus:border-rose-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-200"
                  />
                </div>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                  <div>
                    <label for="guestEmail" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                      Email Address
                    </label>
                    <input
                      type="email"
                      id="guestEmail"
                      name="guestEmail"
                      required
                      value="<%= oldInput && oldInput.guestEmail ? oldInput.guestEmail : (user ? user.email : '') %>"
                      placeholder="you@example.com"
                      class="mt-1.5 block w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm text-slate-800 transition focus:border-rose-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-200"
                    />
                  </div>
                  <div>
                    <label for="guestPhone" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                      Phone Number
                    </label>
                    <input
                      type="tel"
                      id="guestPhone"
                      name="guestPhone"
                      required
                      value="<%= oldInput && oldInput.guestPhone ? oldInput.guestPhone : '' %>"
                      placeholder="+91 9876543210"
                      class="mt-1.5 block w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm text-slate-800 transition focus:border-rose-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-200"
                    />
                  </div>
                </div>

                <div>
                  <label for="specialRequests" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                    Special Requests (Optional)
                  </label>
                  <textarea
                    id="specialRequests"
                    name="specialRequests"
                    rows="3"
                    placeholder="Early check-in request, dietary notes, or any questions for the host..."
                    class="mt-1.5 block w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm text-slate-800 transition focus:border-rose-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-200"
                  ><%= oldInput && oldInput.specialRequests ? oldInput.specialRequests : '' %></textarea>
                </div>
              </div>
            </div>

            <!-- Cancellation & Policy Note -->
            <div class="rounded-xl bg-slate-50 p-4 text-xs text-slate-600 leading-relaxed border border-slate-200/60">
              <p class="font-bold text-slate-800 mb-1">🛡️ Cancellation Policy</p>
              Free cancellation before check-in date. By confirming your booking, you agree to the homyfyy house rules and terms of service.
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="submitBtn"
              class="w-full rounded-xl bg-gradient-to-r from-rose-600 to-red-600 py-3.5 px-6 text-center text-base font-bold text-white shadow-lg shadow-rose-500/25 transition duration-200 hover:-translate-y-0.5 hover:from-rose-700 hover:to-red-700 hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-rose-300"
            >
              Confirm Reservation
            </button>
          </form>
        </div>

        <!-- Price Breakdown & Summary Sticky Column -->
        <div class="lg:col-span-5">
          <div class="sticky top-6 rounded-2xl border border-slate-200/80 bg-white p-6 shadow-md">
            <!-- Property Card Header -->
            <div class="flex gap-4 border-b border-slate-100 pb-5">
              <img
                src="<%= home.photo %>"
                alt="<%= home.houseName %>"
                class="h-24 w-28 rounded-xl object-cover shadow-sm"
              />
              <div class="flex flex-col justify-between">
                <div>
                  <span class="inline-flex items-center gap-1 text-xs font-semibold text-rose-600">
                    <span aria-hidden="true">★</span> <%= home.rating %> rating
                  </span>
                  <h3 class="text-base font-bold text-slate-900 leading-snug line-clamp-2">
                    <%= home.houseName %>
                  </h3>
                </div>
                <p class="text-xs text-slate-500">
                  <span aria-hidden="true">⌖</span> <%= home.location %>
                </p>
              </div>
            </div>

            <!-- Price Breakdown Calculation -->
            <div class="py-5">
              <h4 class="text-sm font-bold uppercase tracking-wider text-slate-700 mb-3">
                Price details
              </h4>
              <div class="space-y-2.5 text-sm">
                <div class="flex justify-between text-slate-600">
                  <span>Price per night</span>
                  <span class="font-medium text-slate-900">₹<span id="pricePerNight"><%= home.price %></span></span>
                </div>
                <div class="flex justify-between text-slate-600">
                  <span id="nightsLabel">Total nights</span>
                  <span class="font-medium text-slate-900"><span id="nightsCount">1</span> night(s)</span>
                </div>
                <div class="flex justify-between text-slate-600">
                  <span>Service & cleaning fee</span>
                  <span class="font-semibold text-emerald-600">Free</span>
                </div>
              </div>

              <div class="mt-4 border-t border-slate-100 pt-4 flex items-center justify-between">
                <span class="text-base font-bold text-slate-900">Total (INR)</span>
                <span class="text-2xl font-black text-rose-600">₹<span id="totalDisplay"><%= home.price %></span></span>
              </div>
            </div>

            <div class="rounded-xl border border-emerald-100 bg-emerald-50/60 p-3.5 text-xs text-emerald-800 flex items-start gap-2">
              <span class="text-base" aria-hidden="true">✨</span>
              <span><strong>Instant Confirmation:</strong> Your dates will be reserved as soon as you confirm.</span>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script>
      (function() {
        const pricePerNight = <%= home.price %>;
        const checkInInput = document.getElementById("checkIn");
        const checkOutInput = document.getElementById("checkOut");
        const nightsCount = document.getElementById("nightsCount");
        const totalDisplay = document.getElementById("totalDisplay");
        const nightsLabel = document.getElementById("nightsLabel");

        // Set minimum dates
        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);

        const formatDate = (d) => d.toISOString().split("T")[0];

        if (!checkInInput.value) {
          checkInInput.min = formatDate(today);
          checkInInput.value = formatDate(today);
        } else {
          checkInInput.min = formatDate(today);
        }

        if (!checkOutInput.value) {
          checkOutInput.min = formatDate(tomorrow);
          checkOutInput.value = formatDate(tomorrow);
        } else {
          checkOutInput.min = formatDate(tomorrow);
        }

        function calculate() {
          const inVal = checkInInput.value;
          const outVal = checkOutInput.value;

          if (inVal && outVal) {
            const inDate = new Date(inVal);
            const outDate = new Date(outVal);

            // Ensure checkout is after checkin
            const nextDay = new Date(inDate);
            nextDay.setDate(nextDay.getDate() + 1);
            checkOutInput.min = formatDate(nextDay);

            const diffTime = outDate.getTime() - inDate.getTime();
            const nights = Math.max(1, Math.ceil(diffTime / (1000 * 60 * 60 * 24)));

            nightsCount.textContent = nights;
            nightsLabel.textContent = `₹${pricePerNight} × ${nights} night${nights > 1 ? 's' : ''}`;
            totalDisplay.textContent = (nights * pricePerNight).toLocaleString('en-IN');
          }
        }

        checkInInput.addEventListener("change", function() {
          const inDate = new Date(this.value);
          const nextDay = new Date(inDate);
          nextDay.setDate(nextDay.getDate() + 1);
          checkOutInput.min = formatDate(nextDay);
          if (new Date(checkOutInput.value) <= inDate) {
            checkOutInput.value = formatDate(nextDay);
          }
          calculate();
        });

        checkOutInput.addEventListener("change", calculate);
        calculate();
      })();
    </script>
  </body>
</html>
