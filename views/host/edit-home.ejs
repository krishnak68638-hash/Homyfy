<%- include('../partials/head') %>
  <body class="bg-slate-100">
    <%- include('../partials/nav') %>

    <main class="page-shell form-shell mx-auto mt-10 max-w-xl rounded-2xl bg-white p-8 shadow-xl">
      <div class="form-intro">
        <span class="section-eyebrow">YOUR HOMYFYY SPACE</span>
        <h1 class="page-heading mb-2 mt-2 text-center text-3xl font-bold">Edit your listing</h1>
        <p>Update your home details and keep your listing fresh.</p>
      </div>

      <form action="/host/edit-home/<%= home._id %>" method="POST" enctype="multipart/form-data" class="space-y-4 text-left">
        <input type="hidden" name="id" value="<%=editing ? home._id : ''%>" />
        <div>
          <label class="mb-1 block font-medium text-slate-700">House Name</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none ring-0 focus:border-red-400" type="text" name="houseName"
           value="<%= home.houseName %>" placeholder="Enter the name of your house" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Price</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="number" name="price" value="<%= home.price %>" placeholder="Enter price" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Location</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="text" name="location" value="<%= home.location %>" placeholder="Enter location" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Rating</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="number" step="0.1" min="1" max="5" name="rating" value="<%= home.rating %>" placeholder="Enter rating" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Home-Photo</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="file" name="photo" accept="image/jpg, image/jpeg, image/png" />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Replace Home Rules (PDF or TXT, optional)</label>
          <% if (home.houseRules) { %>
            <p class="mb-2 text-sm text-slate-600">A rules file is already uploaded. Choose a new file only if you want to replace it.</p>
          <% } %>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="file" name="houseRules" accept=".pdf,.txt,application/pdf,text/plain" />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Description</label>
          <textarea class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="text"  name="description" value="<%= home.description %>" placeholder="Describe your home"  ></textarea>
        </div>

        <button class="w-full rounded-full bg-red-500 px-4 py-3 font-semibold text-white transition hover:bg-red-600" type="submit">Update Home</button>
      </form>
    </main>
  </body>
</html>
