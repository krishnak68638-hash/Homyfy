<%- include('../partials/head') %>
  <body class="bg-slate-100">
    <%- include('../partials/nav') %>

    <main class="mx-auto mt-10 max-w-xl rounded-2xl bg-white p-8 shadow-xl">
      <h1 class="mb-6 text-center text-3xl font-bold text-red-500">Edit your home here</h1>

      <form action="/host/edit-home/<%= home.id %>" method="POST" class="space-y-4 text-left">
        <input type="hidden" name="id" value="<%=editing ? home.id : ''%>" />
        <div>
          <label class="mb-1 block font-medium text-slate-700">House Name</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none ring-0 focus:border-red-400" type="text" name="houseName"
           value="<%= home.houseName %>" placeholder="Enter the name of your house" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Price</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="number" name="price" value="<%= home.price %>" placeholder="Enter price" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Location</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="text" name="location" value="<%= home.location %>" placeholder="Enter location" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Rating</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="number" step="0.1" min="1" max="5" name="rating" value="<%= home.rating %>" placeholder="Enter rating" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Photo URL</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="text" name="photoUrl" value="<%= home.photoUrl %>" placeholder="Enter image URL" required />
        </div>

        <button class="w-full rounded-full bg-red-500 px-4 py-3 font-semibold text-white transition hover:bg-red-600" type="submit">Update Home</button>
      </form>
    </main>
  </body>
</html>
