<%- include('../partials/head') %>
  <body class="bg-slate-100">
    <%- include('../partials/nav') %>

    <main class="page-shell form-shell mx-auto mt-10 max-w-xl rounded-2xl bg-white p-8 shadow-xl">
      <div class="form-intro">
        <span class="section-eyebrow">SHARE A PLACE YOU LOVE</span>
        <h1 class="page-heading mb-2 mt-2 text-center text-3xl font-bold">List your home</h1>
        <p>Tell guests what makes your place special.</p>
      </div>

      <form action="/host/host-add-home" method="POST" enctype="multipart/form-data" class="space-y-4 text-left">
        <div>
          <label class="mb-1 block font-medium text-slate-700">House Name</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none ring-0 focus:border-red-400" type="text" name="houseName" placeholder="Enter the name of your house" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Price</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="number" name="price" placeholder="Enter price" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Location</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="text" name="location" placeholder="Enter location" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Rating</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="number" step="0.1" min="1" max="5" name="rating" placeholder="Enter rating" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Home-Photo</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="file" name="photo" accept="image/jpg, image/jpeg, image/png" required />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Home Rules (PDF or TXT, optional)</label>
          <input class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="file" name="houseRules" accept=".pdf,.txt,application/pdf,text/plain" />
        </div>

        <div>
          <label class="mb-1 block font-medium text-slate-700">Description</label>
          <textarea class="w-full rounded-lg border border-red-200 bg-slate-50 p-3 outline-none focus:border-red-400" type="text"  name="description" placeholder="Describe your home" ></textarea>
        </div>

        <button class="w-full rounded-full bg-red-500 px-4 py-3 font-semibold text-white transition hover:bg-red-600" type="submit">Submit</button>
      </form>
    </main>
  </body>
</html>
